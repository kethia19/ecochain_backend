# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Leave blank to use SQLite.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis cache. Leave blank to use in-memory cache.
REDIS_URL=

# Email (SendGrid via django-anymail). Leave blank to print emails to console.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=Eco-Chain <k.kayigire@alustudent.com>

# Geocoding
GOOGLE_MAPS_KEY=

# CORS (comma-separated list of frontend origins)
# Set to specific origins in production e.g. https://your-frontend.vercel.app
# Leave blank to allow all origins in development
CORS_ALLOWED_ORIGINS=